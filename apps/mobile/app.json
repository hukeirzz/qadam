{
  "expo": {
    "name": "Qadam",
    "slug": "qadam",
    "version": "1.0.0",
    "scheme": "qadam",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F6FC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "kg.qadam.app"
    },
    "android": {
      "package": "kg.qadam.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#F7F6FC"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-audio"
    ]
  }
}
